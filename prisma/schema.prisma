// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum STATUS {
  ACTIVE
  INACTIVE
}

enum ITEM_STATUS {
  AVAILABLE
  UNAVAILABLE
  DISCONTINUED
  SOLD_OUT
}

enum ACCOUNT_TYPE {
  DEVELOPER
  HEADQUARTER
  OUTLET
  OUTLET_STAFF
}

enum STAFF_STATUS {
  GENERAL_MANAGER
  ASSISTANT_MANAGER
  SHIFT_MANAGER
  CASHIER
  SERVER
  HOST
  COOK
  CHEF
  KITCHEN_STAFF
  BARISTA
  DELIVERY_DRIVER
  CLEANER
}

enum EMPLOYMENT_TYPE {
  FULL_TIME
  PART_TIME
  TEMPORARY
  SEASONAL
  CONTRACTOR
}

enum SALARY_TYPE {
  HOURLY
  SALARY
}

enum REMINDER_STATUS {
  OPEN
  DONE
}

enum REMINDER_PRIORITY {
  LOW
  NORMAL
  HIGH
}

enum ORDER_STATUS {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SHIFT_STATUS {
  ON_SHIFT
  COMPLETED
  ABSENCE
}

enum ORDER_TYPE {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model User {
  id                String            @id @default(cuid())
  branchId          String?
  staffId           String?
  email             String            @unique
  password          String
  hash              String
  roleId            String
  status            STATUS            @default(ACTIVE)
  accountType       ACCOUNT_TYPE      @default(HEADQUARTER)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company?          @relation(fields: [branchId], references: [id])
  staff             Staff?            @relation(fields: [staffId], references: [id])
  role              Role              @relation(fields: [roleId], references: [id])
  salesOrders       SalesOrder[]
  shiftsStarted     StaffShift[]      @relation("ShiftStartedBy")
  shiftsEnded       StaffShift[]      @relation("ShiftEndedBy")
  breaksStarted     StaffShiftBreak[] @relation("BreakStartedBy")
  breaksEnded       StaffShiftBreak[] @relation("BreakEndedBy")
  sessions          UserSession[]
  reminders         Reminder[]
  acceptedReminders Reminder[]        @relation("ReminderAcceptedBy")
  reminderReplies   ReminderReply[]
}

model Company {
  id                 String            @id @default(cuid())
  name               String?
  contactPersonName  String
  contactPersonEmail String            @unique
  contactPersonPhone String            @unique
  address            String
  city               String
  state              String
  zipCode            String
  country            String
  companyLogo        String?
  companyBanner      String?
  parentId           String?
  status             STATUS            @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  parent             Company?          @relation("CompanyToCompany", fields: [parentId], references: [id])
  children           Company[]         @relation("CompanyToCompany")
  users              User[]
  staffs             Staff[]
  staffAssignments   StaffAssignment[]
  menuItemOutlets    MenuItemOutlet[]
  salesOrders        SalesOrder[]
  staffShifts        StaffShift[]
  roles              Role[]
  reminders          Reminder[]        @relation("CompanyReminders")
  outletReminders    Reminder[]        @relation("OutletReminders")

  @@unique([parentId, name])
}

model Staff {
  id             String            @id @default(cuid())
  branchId       String
  badgeNumber    String            @unique
  designation    STAFF_STATUS
  employmentType EMPLOYMENT_TYPE
  jobTitle       String
  firstName      String
  lastName       String
  email          String?
  phone          String
  gender         String
  dob            String
  profileImage   String?
  address1       String
  address2       String?
  city           String
  state          String
  country        String
  salaryType     SALARY_TYPE       @default(SALARY)
  hireDate       DateTime          @default(now())
  exitDate       DateTime?
  qrData         String?
  status         STATUS            @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  outlet         Company           @relation(fields: [branchId], references: [id])
  users          User[]
  assignments    StaffAssignment[]
  salesOrders    SalesOrder[]
  shifts         StaffShift[]
  reminders      Reminder[]
}

model StaffAssignment {
  id        String    @id @default(cuid())
  staffId   String
  branchId  String
  startDate DateTime
  endDate   DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  outlet    Company   @relation(fields: [branchId], references: [id], onDelete: Restrict)
}

model StaffShift {
  id          String            @id @default(cuid())
  staffId     String
  branchId    String
  startedById String?
  endedById   String?
  clockInAt   DateTime          @default(now())
  clockOutAt  DateTime?
  status      SHIFT_STATUS      @default(ON_SHIFT)
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  staff       Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  outlet      Company           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  startedBy   User?             @relation("ShiftStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy     User?             @relation("ShiftEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  breaks      StaffShiftBreak[]

  @@index([branchId, status])
  @@index([staffId, status])
}

model StaffShiftBreak {
  id          String     @id @default(cuid())
  shiftId     String
  startedById String?
  endedById   String?
  startAt     DateTime   @default(now())
  endAt       DateTime?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shift       StaffShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startedBy   User?      @relation("BreakStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy     User?      @relation("BreakEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([shiftId, endAt])
}

model Menu {
  id          String     @id @default(cuid())
  name        String
  description String?
  menuImage   String?
  status      STATUS     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]
}

model MenuItem {
  id             String           @id @default(cuid())
  menuId         String
  name           String
  description    String?
  menuItemImage  String?
  status         ITEM_STATUS      @default(AVAILABLE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  menu           Menu             @relation(fields: [menuId], references: [id])
  menuItemPrices MenuItemPrice[]
  itemOutlets    MenuItemOutlet[]
  orderItems     SalesOrderItem[]

  @@unique([menuId, name])
}

model MenuItemOutlet {
  id         String   @id @default(cuid())
  menuItemId String
  branchId   String
  price      Decimal? @db.Decimal(10, 2)
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  outlet     Company  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, branchId])
}

model MenuItemPrice {
  id         String   @id @default(cuid())
  menuItemId String
  basePrice  Decimal  @db.Decimal(10, 2)
  price      Decimal  @default(0.0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model SalesOrder {
  id            String           @id @default(cuid())
  branchId      String
  serverId      String
  createdById   String?
  orderNumber   String
  orderType     ORDER_TYPE       @default(DINE_IN)
  tableNumber   String?
  customerName  String?
  note          String?
  totalItems    Int              @default(0)
  totalAmount   Decimal          @default(0.0) @db.Decimal(10, 2)
  status        ORDER_STATUS     @default(CONFIRMED)
  confirmedAt   DateTime         @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  slipPrintedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  outlet        Company          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  server        Staff            @relation(fields: [serverId], references: [id], onDelete: Restrict)
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         SalesOrderItem[]

  @@unique([branchId, orderNumber])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  menuItemId   String
  itemName     String
  unitPrice    Decimal    @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, menuItemId])
}

model Role {
  id                String            @id @default(cuid())
  key               String            @unique
  name              String
  description       String?
  isSystem          Boolean           @default(false)
  companyId         String?
  status            STATUS            @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             User[]
  permissionBatches PermissionBatch[]

  @@unique([companyId, name])
}

model Permission {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  status          STATUS            @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  batchPermission PermissionBatch[]
}

model PermissionBatch {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  status       STATUS     @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reminder {
  id           String            @id @default(cuid())
  companyId    String
  outletId     String?
  staffId      String?
  createdById  String?
  title        String
  notes        String?
  dueAt        DateTime
  priority     REMINDER_PRIORITY @default(NORMAL)
  status       REMINDER_STATUS   @default(OPEN)
  completedAt  DateTime?
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  company      Company           @relation("CompanyReminders", fields: [companyId], references: [id], onDelete: Cascade)
  outlet       Company?          @relation("OutletReminders", fields: [outletId], references: [id], onDelete: SetNull)
  staff        Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy   User?             @relation("ReminderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  replies      ReminderReply[]

  @@index([companyId, status, dueAt])
}

model ReminderReply {
  id         String   @id @default(cuid())
  reminderId String
  authorId   String?
  message    String?
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reminderId, createdAt])
}
